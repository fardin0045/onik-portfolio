# ─────────────────────────────────────────────────────────────
#  One-time migration: local DB + local uploads → Atlas + Cloudinary
#  cp .env.migrate.example .env.migrate   (never commit .env.migrate)
#  npm run migrate
# ─────────────────────────────────────────────────────────────
NODE_ENV=development

# FROM: your local development database
SOURCE_MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# TO: your MongoDB Atlas connection string (include the database name, e.g. /portfolio)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Files go to Cloudinary
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# Required by the config loader (any 32+ char value; not used by the migration)
JWT_SECRET=migration-only-secret-value-000000000000
