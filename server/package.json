{
  "name": "onik-portfolio-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API + CMS backend for Onik's portfolio",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:memory": "node --env-file-if-exists=.env src/dev-memory.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed/seed.js",
    "create-admin": "node --env-file-if-exists=.env src/seed/create-admin.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "migrate": "node --env-file-if-exists=.env.migrate src/scripts/migrate.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0"
  }
}
