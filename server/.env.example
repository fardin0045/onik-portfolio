# ─────────────────────────────────────────────────────────────
#  Portfolio API – environment variables
#  Copy to `.env` for local development. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB (local: mongodb://127.0.0.1:27017/portfolio  |  Atlas: mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Auth – generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Browser origins allowed to call the API (comma separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173
# lax (same-site deploys / proxy)  |  none (frontend and API on different sites – requires HTTPS)
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true          # defaults to true in production
# COOKIE_DOMAIN=.yourdomain.com
TRUST_PROXY=1

# Public URL of the website (sitemap / canonical fallback)
PUBLIC_SITE_URL=http://localhost:5173
# Serve the built React app from this server (single-service deployment)
SERVE_CLIENT=false
# CLIENT_DIST_PATH=../client/dist

# File storage: local (dev only) | cloudinary (production)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# Optional: e-mail notification for new contact messages
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NOTIFY_EMAIL=

# First admin account (used by `npm run seed` / `npm run create-admin`).
# Password: ≥12 chars with upper, lower case and a number. Remove after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Onik
