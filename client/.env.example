# Base URL of the API. Leave EMPTY when the API is served from the same origin
# (single-service deploy, Vercel rewrites, or the Vite dev proxy).
# Example for a separately hosted API: https://api.yourdomain.com
VITE_API_URL=

# Dev only: where the Vite dev server proxies /api and /uploads
VITE_DEV_API_PROXY=http://localhost:4000
